@baseUrl = http://localhost:4004
@serviceUrl = {{baseUrl}}/odata/v4/travel
@bookingId = 99999999-9999-9999-9999-999999999999

### Service metadata
GET {{serviceUrl}}/$metadata
Accept: application/xml

### List destinations
GET {{serviceUrl}}/Destinations?$select=ID,name,city,countryCode&$orderby=name
Accept: application/json

### List trips with their destination
GET {{serviceUrl}}/Trips?$select=ID,title,startDate,endDate,status&$expand=destination($select=ID,name,city,countryCode)&$orderby=startDate
Accept: application/json

### Find pending bookings with their trip and traveler
GET {{serviceUrl}}/Bookings?$filter=status%20eq%20%27PENDING%27&$select=ID,bookingReference,bookingDate,status,totalAmount,currencyCode&$expand=trip($select=ID,title),traveler($select=ID,firstName,lastName,email)
Accept: application/json

### Confirm a booking
POST {{serviceUrl}}/confirmBooking
Content-Type: application/json
Accept: application/json

{
  "bookingId": "{{bookingId}}"
}

### Read the confirmed booking
GET {{serviceUrl}}/Bookings({{bookingId}})?$select=ID,bookingReference,status,trip_ID,traveler_ID
Accept: application/json

# MCP endpoint: {{baseUrl}}/mcp/odata/v4/travel