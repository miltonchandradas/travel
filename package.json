{
  "name": "travel",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/mcp": "^1.4.3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db/travel.sqlite"
        }
      }
    },
    "[production]": {
      "requires": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa"
      }
    }
  },
  "private": true
}
